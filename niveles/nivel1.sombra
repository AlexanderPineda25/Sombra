// Nivel 1 del museo, escrito en el lenguaje SOMBRA.
// Leyenda del mapa:  # pared  . piso  P ladrón  J joya  X salida  H arbusto
//                    C cámara  T terminal  D puerta  L rejilla láser
nivel "El vestíbulo" {

    mapa {
        "##############################"
        "#P.......#..........#.......J#"
        "#........#..........#........#"
        "#..HH....#....##....#....HH..#"
        "#........#....##.............#"
        "#.............##....#........#"
        "#####..######.##.####..#######"
        "#....................#.......#"
        "#....................#...H...#"
        "#..H......#######....#.......#"
        "#.........#.....#............#"
        "#.........#..J..#....#.......#"
        "#.........#.....#....#....H..#"
        "#....H....##DDD##....#.......#"
        "#...............T....#########"
        "#######..#########...........#"
        "#.............H..#...........#"
        "#.J...........H..#.......X...#"
        "#................#...........#"
        "##############################"
    }

    guardia {                // G1
        ir (2, 7)
        ir (19, 7)
        esperar 2
        ir (19, 13)
        ir (2, 13)
        mirar izquierda 1.2
    }
    guardia {                // G2
        ir (17, 4)
        ir (28, 4)
        mirar abajo 1.5
    }

    terminal (16, 14) cerradura
    radar (5, 11)
}
